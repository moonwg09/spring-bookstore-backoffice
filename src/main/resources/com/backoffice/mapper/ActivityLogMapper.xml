<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.backoffice.mapper.ActivityLogMapper">

    <insert id="insertLog">
        INSERT INTO Activity_Log (employee_id, action)
        VALUES (#{employee_id}, #{action})
    </insert>

	<!--  HR 관리 페이지용 활동 로그 목록 조회 (최신순 50건) -->
    <select id="selectActivityLogList" resultType="com.backoffice.model.ActivityLogVO">
        SELECT * FROM (
            SELECT 
                a.log_id, 
                a.employee_id, 
                a.action, 
                a.timestamp,
                NVL(e.name, '시스템') AS employeeName,
                NVL(e.role, 'ADMIN') AS role
            FROM Activity_log a
            LEFT JOIN Employee e ON a.employee_id = e.employee_id
            ORDER BY a.log_id DESC
        )
        WHERE ROWNUM &lt;= 50
    </select>
</mapper>